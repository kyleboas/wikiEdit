# Optional model override for the Flue agent.
WIKIEDIT_MODEL=anthropic/claude-sonnet-4-6

# Optional MediaWiki endpoint; defaults to English Wikipedia.
WIKI_API_URL=https://en.wikipedia.org/w/api.php

# Optional write credentials. Use a MediaWiki bot password, not your main password.
# Required only for apply=sandbox, apply=talk, or apply=live.
WIKI_USERNAME=
WIKI_BOT_PASSWORD=

# Live encyclopedia edits are disabled unless this exact flag is set and payload.humanReviewed=true.
WIKI_ALLOW_LIVE_EDIT=false

# Optional YouTube transcript gateway, compatible with the Tactics Journal Dynamic Workers gateway.
DYNAMIC_WORKERS_HOST=
DYNAMIC_WORKERS_SECRET=
